# Site analytics + notifications (all optional).
# Copy to `.env.local` and fill in the values you want. With none set,
# the site still works — tracking simply stays off. See setup.md for details.

# ── Dashboards ──────────────────────────────────────────────────────────────
# Plausible — your verified site domain (privacy-friendly, script loads if set).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Google Analytics 4 — your Measurement ID (looks like G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=

# ── Notifications (Discord/Slack incoming webhook URLs) ──────────────────────
# Fires a message on each new visit (once per browser session).
NEXT_PUBLIC_VISIT_WEBHOOK_URL=

# Fires a message on each resume download (includes the optional email).
# NOTE: webhook URLs are embedded in the public client bundle. Anyone could
# POST to them, so treat them as low-sensitivity and rotate if abused.
NEXT_PUBLIC_DOWNLOAD_WEBHOOK_URL=

